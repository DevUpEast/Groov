{
  "expo": {
    "name": "Groov",
    "slug": "MyApp",
    "version": "1.1.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "groov",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4546AC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beastlyiceking.groov",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4546AC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "package": "com.beastlyiceking.groov",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Groov to access your photos to set habit icons.",
          "cameraPermission": "Allow Groov to use the camera to take a habit icon photo."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "isaac-23",
          "project": "groov"
        }
      ],
      "expo-quick-actions",
      "./plugins/withFontScaleConfigChange",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "GroovToday",
              "label": "Groov: Today",
              "description": "Today's habits with one-tap check-off",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "6039d704-fe72-4442-a7c7-81f44a1072e9"
      }
    },
    "owner": "isaaceast"
  }
}
